# --- Server auth ---
# Firebase Admin service account: either the raw JSON, or a base64 encoding of it.
# Example (base64): FIREBASE_SERVICE_ACCOUNT=<base64-of-service-account.json>
FIREBASE_SERVICE_ACCOUNT=

# Optional: path to a local service account JSON instead of FIREBASE_SERVICE_ACCOUNT.
# GOOGLE_APPLICATION_CREDENTIALS=./private-keys/service-account.json

# Optional: use a specific Firestore database id (defaults to the project default).
# FIRESTORE_DATABASE_ID=(default)

# --- AI provider ---
# Gemini API key for chat + memory extraction (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: model name used for chat + memory extraction. Defaults to gemini-3.7-flash.
# GEMINI_MODEL=gemini-3.7-flash

# Optional: fall back to an OpenAI-compatible endpoint (chat/completions) when Gemini is unavailable.
# OPENAI_COMPATIBLE_BASE_URL=

# --- Server ---
# PORT=3000
# NODE_ENV=development

# --- Frontend (build-time) ---
# Override the public Firebase auth config baked into src/lib/firebase.ts.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=